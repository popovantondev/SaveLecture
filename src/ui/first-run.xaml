<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#FCFDFF" BorderBrush="#C5D7EA" BorderThickness="1" CornerRadius="8" TextElement.FontFamily="Segoe UI" TextElement.Foreground="#132443" UseLayoutRounding="True">
<Border.Resources>
<Style TargetType="Button"><Setter Property="FontSize" Value="16"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="18,11"/><Setter Property="Background" Value="#ECF5FF"/><Setter Property="BorderBrush" Value="#CFE1F3"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" CornerRadius="10" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="16"/></Style>
</Border.Resources>
<Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="54"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="Перед началом работы" FontSize="26" FontWeight="Bold"/><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Язык интерфейса" Foreground="#596F90" VerticalAlignment="Center"/><ContentControl x:Name="LanguageChoice" Grid.Column="1" HorizontalAlignment="Right"/></Grid></StackPanel>
<StackPanel Grid.Row="1" Margin="0,10,0,0">
<Border Background="#EAF4FF" CornerRadius="12" Padding="18"><StackPanel><TextBlock Text="Только с разрешения всех участников" FontWeight="Bold" FontSize="19"/><TextBlock Margin="0,8,0,0" Text="Учебная предварительная версия. Сохраняйте субтитры и слайды только с согласия всех участников и разрешения на материалы. Программа не устанавливает правомерность записи."/></StackPanel></Border>
<TextBlock Margin="0,16,0,0" Text="После нажатия «Запустить» начнётся сохранение и откроется главное окно. При следующих запусках программа работает в трее. Открыть окно можно через значок в трее. «Стоп» завершает запись. Получайте разрешение перед каждой встречей."/>
<CheckBox x:Name="Acknowledged" Margin="0,18,0,0"><TextBlock Text="Я прочитал предупреждение. Согласие участников нужно получить отдельно."/></CheckBox>
</StackPanel>
<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"><Button x:Name="Cancel" Content="Отмена" Margin="0,0,12,0"/><Button x:Name="Accept" Content="Запустить SaveLecture" IsEnabled="False" Background="#0783FF" BorderBrush="#0783FF" Foreground="White"/></StackPanel>
</Grid></Border>
